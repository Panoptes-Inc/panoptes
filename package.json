{
	"name": "panoptes",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write --ignore-unknown .",
		"format:check": "prettier --check --ignore-unknown .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:auth-smoke": "node scripts/smoke-auth-dev.mjs",
		"check:openapi": "node scripts/validate-openapi.mjs",
		"audit:frontend-inventory": "node scripts/audit-frontend-components.mjs",
		"check:frontend-inventory": "node scripts/audit-frontend-components.mjs --check",
		"test:secrets": "node scripts/check-client-secrets.mjs",
		"test:smoke": "node scripts/smoke-routes.mjs",
		"quality": "npm run check && npm run lint && npm run format:check && npm run check:openapi && npm run check:frontend-inventory && npm run test && npm run test:auth-smoke && npm run build && npm run test:secrets && npm run test:smoke"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"eslint": "^10.8.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.48.2",
		"svelte-check": "^4.7.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.97.0",
		"gsap": "^3.14.2"
	}
}
