PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
PUBLIC_TURNSTILE_SITE_KEY=your-public-turnstile-site-key
PUBLIC_USE_MOCK_API=false

# Development only. Both values are required; production always ignores mock auth.
PANOPTES_ENABLE_MOCK_AUTH=false
PANOPTES_MOCK_AUTH_SCENARIO=anonymous

# SUPABASE_SERVICE_ROLE_KEY is intentionally not used by this frontend project.

# Server-only Rails BFF destination. Never prefix this with PUBLIC_.
PANOPTES_RAILS_API_URL=http://127.0.0.1:3000
PANOPTES_RAILS_API_TIMEOUT_MS=5000
