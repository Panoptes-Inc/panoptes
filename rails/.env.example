POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=panoptes
POSTGRES_PASSWORD=development-only-change-me
DATABASE_URL=postgresql://panoptes:development-only-change-me@db:5432/panoptes_api_development

SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_JWKS_CACHE_TTL_SECONDS=300
SUPABASE_JWKS_STALE_TTL_SECONDS=3600

RAILS_LOG_LEVEL=info
PANOPTES_FRONTEND_ORIGIN=http://localhost:5173

# RAILS_MASTER_KEY is intentionally absent in R-1. Configure it through a secret store only
# if encrypted Rails credentials are introduced in a later phase.
